{"nodes": [{"id": "docs_architecture_architecture_decisions_adr_001_monorepo", "label": "ADR-001 Monorepo Structure", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_location": "ADR-001", "source_url": null, "captured_at": null, "author": "Agent 1", "contributor": null, "rationale": "A unified workspace reduces schema drift and cross-repository integration friction while preserving path ownership boundaries."}, {"id": "docs_architecture_architecture_decisions_adr_002_database_access", "label": "ADR-002 FastAPI Database Access Strategy", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_location": "ADR-002", "source_url": null, "captured_at": null, "author": "Agent 1", "contributor": null, "rationale": "SQLAlchemy AsyncIO supports typed joins, transactions, and vector queries; Supabase SDK remains limited to Auth, Storage, and administration."}, {"id": "docs_architecture_architecture_decisions_adr_003_authentication", "label": "ADR-003 Authentication and JWT Validation", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_location": "ADR-003", "source_url": null, "captured_at": null, "author": "Agent 1", "contributor": null, "rationale": "Supabase Auth provides stateless JWT identity for browsers, APIs, and non-browser MCP clients without trusting client-supplied user IDs."}, {"id": "docs_architecture_architecture_decisions_adr_004_canonical_data_source", "label": "ADR-004 Canonical Data Source", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_location": "ADR-004", "source_url": null, "captured_at": null, "author": "Agent 1", "contributor": null, "rationale": "PostgreSQL is the transactional source of truth; Storage holds binaries and Markdown plus Drive are derived portable snapshots."}, {"id": "docs_architecture_architecture_decisions_adr_005_markdown_export", "label": "ADR-005 Markdown Export Strategy", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_location": "ADR-005", "source_url": null, "captured_at": null, "author": "Agent 1", "contributor": null, "rationale": "YAML-frontmatter Markdown combines human readability with stable IDs and relationships needed for restoration."}, {"id": "docs_architecture_architecture_decisions_adr_006_ai_provider_abstraction", "label": "ADR-006 AI Provider Abstraction", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_location": "ADR-006", "source_url": null, "captured_at": null, "author": "Agent 1", "contributor": null, "rationale": "A lightweight provider interface avoids vendor lock-in and preserves direct control over retries, prompts, streaming, and usage metadata."}, {"id": "docs_architecture_architecture_decisions_adr_007_vector_search", "label": "ADR-007 Embedding and Vector Search Strategy", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_location": "ADR-007", "source_url": null, "captured_at": null, "author": "Agent 1", "contributor": null, "rationale": "Keeping vectors in user-scoped PostgreSQL avoids data fragmentation and combines semantic similarity with exact keyword retrieval."}, {"id": "docs_architecture_architecture_decisions_adr_008_background_jobs", "label": "ADR-008 Background Job Strategy", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_location": "ADR-008", "source_url": null, "captured_at": null, "author": "Agent 1", "contributor": null, "rationale": "Persistent database job records survive process restarts without requiring Redis or RabbitMQ in the initial deployment."}, {"id": "docs_architecture_architecture_decisions_adr_009_oauth_token_storage", "label": "ADR-009 Google OAuth Token Storage", "file_type": "rationale", "source_file": "docs/architecture/architecture_decisions.md", "source_locatio