# Copy to apps/web/.env.local (gitignored).
# ONLY browser-safe values. Never put DATABASE_URL or SUPABASE_SECRET_KEY here.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=staging

# Supabase staging project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_STAGING_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
