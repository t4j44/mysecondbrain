# Copy to apps/api/.env (gitignored). Placeholders only — never commit real secrets.
# Use a NON-PRODUCTION Supabase staging project. Do not point at production.

APP_ENV=staging
ENVIRONMENT=staging
API_V1_PREFIX=/api/v1
PORT=8000
LOG_LEVEL=INFO

# Refuse to boot unless migrations are applied. Keep enabled.
DATABASE_SCHEMA_VERIFY=true

# Supabase > Project Settings > Database > Connection string (URI)
# Prefer postgresql+asyncpg:// for the API SQLAlchemy engine.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_STAGING_DB_PASSWORD@db.YOUR_STAGING_PROJECT_REF.supabase.co:5432/postgres

# Same staging DB for postgres integration / bootstrap (never production).
POSTGRES_TEST_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_STAGING_DB_PASSWORD@db.YOUR_STAGING_PROJECT_REF.supabase.co:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_STAGING_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Local web origin (CORS). Adjust if the frontend runs elsewhere.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Generate two distinct random strings (32+ chars). Do not reuse production values.
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_MIN_32_CHARS
TOKEN_ENCRYPTION_KEY=YOUR_RANDOM_TOKEN_ENCRYPTION_KEY_MIN_32_CHARS

# Optional HS256 migration / local testing only. Prefer JWKS from SUPABASE_URL.
# SUPABASE_JWKS_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=

# $0 beta default. Keep this mode when using unpaid Gemini API services.
GEMINI_API_KEY=placeholder_gemini_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_DATA_MODE=free_redacted
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=2048
JOB_WORKER_ENABLED=true

# OAuth Web client, server secrets only. Add this exact redirect in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/settings/integrations/google/callback
OPENAI_API_KEY=

STORAGE_BUCKET_DOCUMENTS=brain-documents

MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_SERVER_URL=http://localhost:8000/mcp
MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1","127.0.0.1:*"]
