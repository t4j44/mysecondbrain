# Taj's Second Brain - Production API Environment Configuration

# Server & Service Settings (names match app/config.py exactly)
APP_NAME="Taj's Second Brain API"
APP_VERSION="1.0.0"
APP_ENV="production"
ENVIRONMENT="production"
API_V1_PREFIX="/api/v1"
PORT=8000
CORS_ORIGINS=["https://second-brain.vercel.app"]
CORS_ALLOWED_ORIGINS=["https://second-brain.vercel.app"]
FRONTEND_URL="https://second-brain.vercel.app"

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your-supabase-secret-key"
# SUPABASE_SERVICE_ROLE_KEY="your-legacy-supabase-service-role-key" # Optional legacy migration fallback
SUPABASE_ANON_KEY="your-supabase-anon-key"
DATABASE_URL="postgresql+asyncpg://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres"
# Startup verifies the migrated schema and never creates tables. Keep enabled.
DATABASE_SCHEMA_VERIFY=true

# Separate DEVELOPMENT / STAGING Supabase project (never the production project).
# Used by scripts/db/bootstrap_migrations.py and the postgres integration suite.
# Values must stay out of git — set these locally or in CI secrets only.
# POSTGRES_TEST_DATABASE_URL="postgresql://postgres:dev-password@db.your-DEV-supabase-project.supabase.co:5432/postgres"
# DEV_SUPABASE_URL="https://your-DEV-supabase-project.supabase.co"
# DEV_SUPABASE_SECRET_KEY="sb_secret_your-DEV-secret-key"
# DEV_SUPABASE_ANON_KEY="your-DEV-anon-key"

# JWT Authentication (JWKS is auto-resolved from SUPABASE_URL in production)
# SUPABASE_JWKS_URL="https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_JWT_SECRET="optional-migration-jwt-secret-for-local-hs256-testing"
JWT_SECRET="your-production-jwt-secret-min-32-chars"
JWT_ALGORITHM="HS256"
TOKEN_ENCRYPTION_KEY="your-production-token-encryption-key"

# AI Core Configuration (Primary: Gemini 1.5 Pro, Disabled: OpenAI)
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-1.5-pro"
OPENAI_API_KEY=""

# Integrations Configuration (Google Drive & Google Calendar)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="https://second-brain.vercel.app/api/auth/callback/google"

# Ephemeral FS Storage (Local temporary processing directory)
STORAGE_TEMP_DIR="/tmp/second_brain_uploads"
STORAGE_BUCKET_DOCUMENTS="brain-documents"

# MCP Streamable HTTP endpoint (same Render service as REST)
MCP_ISSUER_URL="https://your-render-service.onrender.com"
MCP_RESOURCE_SERVER_URL="https://your-render-service.onrender.com/mcp"
MCP_ALLOWED_HOSTS=["your-render-service.onrender.com","localhost","localhost:*","127.0.0.1","127.0.0.1:*"]
