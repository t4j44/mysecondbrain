# -> save as  apps/web/.env.local      (already gitignored, verified)
#
# ONLY browser-safe values belong here. Anything named NEXT_PUBLIC_* is
# visible to anyone who opens the page. Never put the DB URL or the
# service_role / secret key in this file.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=staging

# Supabase > Project Settings > API > Project URL  (same as SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=<STAGING_PROJECT_URL>

# Supabase > Project Settings > API > publishable / anon key. Public by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<STAGING_PUBLISHABLE_KEY>
